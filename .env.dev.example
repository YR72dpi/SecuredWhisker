# SecuredWhisker development stack
VERSION=1.4.1

# User manager (Symfony, PHP)
APP_ENV=dev
DATABASE_URL="pgsql://root:dev-securedwhisker@dev-database:5432/dev-securedwhisker?serverVersion=16&charset=utf8"
CORS_ALLOW_ORIGIN='^.*$'
SYMFONY_PORT=6000
SERVER_HOST=[DOMAIN]
LIMIT_MESSAGES_AGE="-1 week"

# Message service (Go)
SHOW_ONLY_ERROR=false
SOCKET_PORT=6050
SOCKET_HOST=[DOMAIN]

# Frontend
NEXTJS_PORT=6010
NEXTJS_DOMAIN=[DOMAIN]
IP_WHITELIST=""
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# TextManagerGPT
GPT_API_KEY=""
GPT_MODEL=gpt-4o-mini
GPT_TEMPERATURE=0.5
TextManagerGPT_PORT=6020

# PostgreSQL
POSTGRES_DB=dev-securedwhisker
POSTGRES_PASSWORD=dev-securedwhisker
POSTGRES_USER=root
POSTGRES_PORT=5433
POSTGRES_VERSION=16
