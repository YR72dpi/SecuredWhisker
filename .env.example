# SecuredWhisker
VERSION=1.4.1

# User manager (Symfony, PHP)
APP_ENV=prod
DATABASE_URL="pgsql://root:change-me@database:5432/securedwhisker?serverVersion=16&charset=utf8"
CORS_ALLOW_ORIGIN='^.*$'
SYMFONY_PORT=5000
SERVER_HOST=[YOUR_SERVER_DOMAIN_OR_IP]
LIMIT_MESSAGES_AGE="-1 week"

# Message service (Go)
SHOW_ONLY_ERROR=false
SOCKET_PORT=5050
SOCKET_HOST=[YOUR_SERVER_IP]

# Frontend
NEXTJS_PORT=5010
NEXTJS_DOMAIN=[YOUR_FRONTEND_DOMAIN_OR_IP]
IP_WHITELIST="ip,ip,ip"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# TextManagerGPT
GPT_API_KEY=""
GPT_MODEL=gpt-4o-mini
GPT_TEMPERATURE=0.5
TextManagerGPT_PORT=5020

# PostgreSQL
POSTGRES_DB=securedwhisker
POSTGRES_PASSWORD=change-me
POSTGRES_USER=root
POSTGRES_PORT=5432
POSTGRES_VERSION=16
